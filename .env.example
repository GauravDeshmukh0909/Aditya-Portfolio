# ==============================================================================
# EnoughEditz Portfolio - Environment Template
# (Do NOT put secret keys or personal emails here. Copy to .env for local use)
# ==============================================================================

# Google Drive Root Folder ID
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id_here
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id_here

# Contact & Social Links
VITE_CONTACT_EMAIL=your_email@example.com
VITE_YOUTUBE_URL=https://www.youtube.com/@yourchannel
VITE_FIVERR_URL=https://www.fiverr.com

# Server Port
PORT=3000
